# ==========================================
# MiyoHub Captcha 环境变量配置表
# ==========================================

# 1. 安全与鉴权
# API 访问令牌（Bearer Token）
# 默认值: 空（不启用鉴权，仅推荐在 127.0.0.1 或 Docker 内网使用）
# 若服务暴露到公网或跨主机访问，强烈建议设置高强度随机密码
CAPTCHA_API_TOKEN=

# 2. 推理性能与线程控制
# ONNX Runtime 推理并发线程数
# 默认值: 2（建议根据 CPU 核心数分配，1~4 为宜）
ORT_THREADS=2

# OpenMP 线程数（底层算子优化）
# 默认值: 2
OMP_NUM_THREADS=2

# OpenBLAS 矩阵计算线程数
# 默认值: 1
OPENBLAS_NUM_THREADS=1

# 3. 内部路径与特性开关（通常保持默认即可）
# 模型存放路径（镜像内置已包含所有模型）
# 默认值: /models
CAPTCHA_MODEL_DIR=/models

# 临时工作目录
# 默认值: /tmp/captcha
CAPTCHA_WORK_DIR=/tmp/captcha

# 模型功能开关 (1: 启用, 0: 禁用)
# use_pdl: 启用点选定位模型 (默认 1)
# use_dfine: 启用 D-FINE 检测器 (默认 1)
# use_multi: 启用多目标文字识别 (默认 1)
use_pdl=1
use_dfine=1
use_multi=1
